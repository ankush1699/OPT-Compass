# Copy to .env (never commit .env)
DATABASE_URL=postgresql://compass:compass@localhost:5433/compass
# Optional: without a key the API runs in retrieval-only mode (returns cited passages).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
EMBED_MODEL=BAAI/bge-base-en-v1.5
EMBED_DIM=768
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Models. Providers: "anthropic" (paid) or "gemini" (Google AI Studio free tier). There is no default judge.
# Put real keys in the repo-root .env (gitignored); never commit them.
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_EFFORT=
JUDGE_PROVIDER=gemini
JUDGE_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Free tier is rate limited and its prompts may be used by Google to improve its products. Seconds between calls:
GEMINI_FREE_TIER=1
GEMINI_MIN_INTERVAL_S=6.5

# Langfuse tracing (optional). Keys for the self-hosted stack are in observability/.env after make-env.sh.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Gateway (app/main.py). Clients send the secret as "X-API-Key" or "Authorization: Bearer ...".
# Format: name:secret,name2:secret2. Empty means every /ask request is refused (fails closed).
# Generate a secret with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
RATE_LIMIT_PER_MINUTE=20

# Public demo page at / (off unless 1). Anonymous visitors, so these limits protect the free-tier quota.
DEMO_ENABLED=0
DEMO_DAILY_LIMIT=150
DEMO_PER_MINUTE=4
DEMO_MAX_CONCURRENT=2
# Set to 1 only behind a proxy you control (it then trusts the last X-Forwarded-For entry).
TRUST_PROXY_HEADERS=0
# Owner-only usage counts at GET /stats (send as X-Stats-Key). Empty means /stats is refused.
STATS_KEY=
# Keeps the visitor hash stable across restarts. Empty means a random salt per process.
ANALYTICS_SALT=
